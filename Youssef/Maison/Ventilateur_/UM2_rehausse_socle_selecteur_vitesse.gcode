;too soon. However if the file hasn't ended yet because there are comments at
;the end of the file, it won't abort yet. Therefore we have to put at least 512
;bytes at the end of the g-code so that the file is not yet finished by the
;time that the motion planner gets flushed. With firmware version _3.3 this
;should be fixed, so this comment wouldn't be necessary any more. Now we have
;to pad this text to make precisely 512 bytes.
M82 ;absolute extrusion mode
;End of Gcode
;SETTING_3 {"global_quality": "[general]\\nversion = 4\\nname = Normal #2\\ndefi
;SETTING_3 nition = ultimaker2_plus\\n\\n[metadata]\\ntype = quality_changes\\nq
;SETTING_3 uality_type = fast\\nsetting_version = 25\\n\\n[values]\\nadhesion_ty
;SETTING_3 pe = brim\\nsupport_structure = tree\\nsupport_type = buildplate\\n\\
;SETTING_3 n", "extruder_quality": ["[general]\\nversion = 4\\nname = Normal #2\
;SETTING_3 \ndefinition = ultimaker2_plus\\n\\n[metadata]\\ntype = quality_chang
;SETTING_3 es\\nquality_type = fast\\nsetting_version = 25\\nposition = 0\\n\\n[
;SETTING_3 values]\\ninfill_pattern = trihexagon\\ninfill_sparse_density = 20\\n
;SETTING_3 speed_layer_0 = 29\\nz_seam_type = shortest\\n\\n"]}
